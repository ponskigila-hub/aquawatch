# Copy to .env. Use the computer's LAN IPv4 address on the same Wi-Fi.
# This API URL is non-secret and will be embedded in the mobile JS bundle.
EXPO_PUBLIC_API_URL=http://192.168.1.25:8000
EXPO_PUBLIC_WEB_APP_URL=http://192.168.1.25:8080

# For phone access away from the same Wi-Fi, use your own HTTPS tunnels instead:
# EXPO_PUBLIC_API_URL=https://your-api-tunnel.ngrok-free.app
# EXPO_PUBLIC_WEB_APP_URL=https://your-web-tunnel.ngrok-free.app
