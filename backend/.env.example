# Comma-separated local frontend origins (Vite defaults to port 8080 in this repo)
AQUAWATCH_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Use ImageNet pretrained ResNet18 weights when they are not already cached.
# Set false for offline demo mode; this initializes an untrained backbone.
AQUAWATCH_DOWNLOAD_PRETRAINED=true

# Optional task-fine-tuned ResNet18Heatmap state_dict path.
# Without this, forecast outputs are illustrative and not operational.
# AQUAWATCH_MODEL_CHECKPOINT=./weights/forecast_resnet18.pt
